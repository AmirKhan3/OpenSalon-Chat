# Port for the server (API + built web app).
PORT=8787

# Postgres connection string. Leave empty in development: the app then uses
# an embedded database stored in ./.data/pglite (nothing to install).
# Example: postgres://user:password@localhost:5432/tolly
DATABASE_URL=

# Sample barbershop data (3 barbers, 6 services, 3 clients) goes into empty
# tables on first start. Set to false to start with empty tables.
SEED_DEMO_DATA=true

# The shop's time zone, used until you save one in Settings.
# All booking times are stored in shop time. Example: America/Chicago
SHOP_TIMEZONE=America/New_York

# Staff login. One shared password for the dashboard.
# Required when NODE_ENV=production: the server does not start without it.
# If it is empty in development, login is off.
STAFF_PASSWORD=

# Signs the login cookie. Use a long random value, for example: openssl rand -hex 32
# If it is empty, staff must log in again each time the server restarts.
SESSION_SECRET=

# Number of reverse proxies in front of the server (usually 1). Leave empty if there is none.
# It tells the server to read the caller's address from X-Forwarded-For.
# Set it only when the server port can be reached through the proxy alone.
TRUST_PROXY=

# The public address of this server, without a slash at the end.
# Used in links we send out (payment pages, booking links). Example: https://book.myshop.com
# If it is empty, links use the address of the request.
PUBLIC_URL=

# Text messages (SMS). Telnyx is the default provider. Twilio is optional.
# With no keys, texts are off and the app still works.
# Which provider to use: telnyx or twilio. If empty, the app picks the one whose keys are set (Telnyx first).
SMS_PROVIDER=
# Telnyx API key (Telnyx portal -> API Keys).
TELNYX_API_KEY=
# The shop's Telnyx number, like +15555550123.
TELNYX_FROM_NUMBER=
# Optional: the messaging profile the number belongs to.
TELNYX_MESSAGING_PROFILE_ID=
# The public key that checks Telnyx webhooks (Telnyx portal -> API Keys -> Public key).
# Webhook address to set in the messaging profile: <PUBLIC_URL>/api/sms/telnyx
TELNYX_PUBLIC_KEY=
# Twilio, only if you use Twilio instead of Telnyx.
# Webhook address to set on the number: <PUBLIC_URL>/api/sms/twilio (PUBLIC_URL must be set).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Stripe, for pre-pay. Leave empty to turn pre-pay off: bookings are then confirmed at once.
# Secret key from the Stripe Dashboard (starts with sk_test_ or sk_live_).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint <PUBLIC_URL>/api/stripe/webhook (starts with whsec_).
STRIPE_WEBHOOK_SECRET=
# Three-letter currency code. Default: usd
STRIPE_CURRENCY=usd

# The AI assistant. Set ONE of the two keys. With no key the assistant is off:
# chats from clients go straight to a barber.
# Vercel AI Gateway key (works with many model providers).
AI_GATEWAY_API_KEY=
# Or an Anthropic API key, to call Anthropic directly.
ANTHROPIC_API_KEY=
# The model. With the gateway use "provider/model" as the gateway lists it.
# Default: claude-sonnet-5-5 (through the gateway: anthropic/claude-sonnet-5-5)
AGENT_MODEL=
